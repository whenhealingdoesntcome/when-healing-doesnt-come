{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manna-missions-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{"binding":"DB", "database_name":"manna-missions-db", "database_id":"87914ee9-ec43-4203-a99a-46c0e9fa32f0", "migrations_dir":"migrations"}],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "manna-missions-photos"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "flat-snowflake-610d.cloudflareaccess.com",
    "ACCESS_AUD": "631f9c3a2998d49b263cbf625d3b2a506d1ca0dd5e0e4d6831b19fc6e0006a96",
    "ADMIN_EMAILS": "heatherkeiko@gmail.com,sharyn.beal@gmail.com"
  }
}
